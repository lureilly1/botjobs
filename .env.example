# Copy to .env and fill in. Nothing here is needed to run the site — only the
# authoring scripts use it. `.env` is gitignored; never commit a real key.
#
#   cp .env.example .env
#
# Used by:
#   scripts/describe-bots.mjs   writes our own summary for each bot
#   scripts/map-jobs.mjs        proposes which jobs a bot fits
#
# Both write their output as a git diff for review. Neither publishes anything:
# the validator still gates what reaches the site.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Defaults to claude-opus-5.
# ANTHROPIC_MODEL=claude-opus-5

# Only needed if your API key is identity-linked (the API will say so).
# Console > Settings > Workspaces — the id is in the URL.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# --- Submissions (T15) -------------------------------------------------------
# All three unset = the submit form is hidden and /api/submit returns 503; the
# page falls back to the GitHub issue route, which always works.
#
# The token belongs to a SEPARATE bot account and needs contents:write on that
# account's FORK only — never on this repo. A leaked token then vandalises a
# fork nobody reads: it cannot touch main, cannot merge, cannot rewrite history.
# SUBMIT_GITHUB_TOKEN=github_pat_...
# SUBMIT_FORK=botjobs-bot/botjobs
# SUBMIT_UPSTREAM=lureilly1/botjobs

# Where submission state and rate-limit counters live. Point this OUTSIDE the
# repo in production so user input can never be committed.
# DATA_DIR=/var/lib/botjobs

# Salt for hashing submitter IPs. We count them, we do not store them.
# IP_SALT=change-me

# --- Analytics ---------------------------------------------------------------
# Server-side, no client JavaScript and no cookies. Events land in
# $DATA_DIR/events.jsonl; read them with `pnpm stats`.
# Optional: also forward to PostHog. Unset = the local log is the whole system.
# POSTHOG_KEY=phc_...
# POSTHOG_HOST=https://eu.i.posthog.com
