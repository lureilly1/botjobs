{
  "name": "botjobs",
  "version": "0.1.0",
  "description": "BotJobs.dev — the independent directory of things you can get Grok Bot to do.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "check": "astro check",
    "validate": "node scripts/validate.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "ingest:grokbot": "node scripts/ingest-grokbot.mjs",
    "ingest": "pnpm ingest:grokbot && pnpm ingest:botstore",
    "ingest:botstore": "node scripts/ingest-botstore.mjs",
    "verify": "node scripts/verify-official.mjs",
    "describe": "node --env-file-if-exists=.env scripts/describe-bots.mjs",
    "map": "node --env-file-if-exists=.env scripts/map-jobs.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "og": "node scripts/generate-og.mjs",
    "integrations": "node --env-file-if-exists=.env scripts/detect-integrations.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@astrojs/node": "^11.1.5",
    "@astrojs/react": "^6.0.5",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.2.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.552.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.1",
    "satori": "^0.33.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
