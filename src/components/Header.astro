---
import { urls } from '@/config';
import { buttonVariants } from '@/components/ui/button';

const nav = [
  { label: 'Jobs', href: urls.jobs() },
  { label: 'Open jobs', href: urls.openJobs() },
  { label: 'Bots', href: urls.bots() },
];

const path = Astro.url.pathname;
---

<header class="border-border bg-background/90 sticky top-0 z-40 border-b backdrop-blur-sm">
  <div class="mx-auto flex h-16 max-w-6xl items-center gap-7 px-4 sm:px-6">
    <a href={urls.home()} class="group flex shrink-0 items-center gap-2">
      <img
        src="/logo-160.png"
        alt=""
        width="40"
        height="40"
        class="size-10 transition-transform group-hover:-rotate-6"
      />
      <span class="font-display text-[17px] leading-none font-extrabold tracking-tight">
        Bot<span class="marker">Jobs</span>
      </span>
    </a>

    <nav class="hidden items-center gap-1 text-sm sm:flex" aria-label="Main">
      {
        nav.map(({ label, href }) => {
          const active = path === href || path.startsWith(href + '/');
          return (
            <a
              href={href}
              aria-current={active ? 'page' : undefined}
              class:list={[
                'rounded-md px-2.5 py-1.5 font-medium transition-colors',
                active
                  ? 'text-foreground decoration-hi-vis underline decoration-2 underline-offset-8'
                  : 'text-muted-foreground hover:text-foreground',
              ]}
            >
              {label}
            </a>
          );
        })
      }
    </nav>

    <div class="ml-auto flex items-center gap-2.5">
      <a
        href={urls.submitJob()}
        class="text-muted-foreground hover:text-foreground hidden text-sm font-medium sm:block"
      >
        Submit a job
      </a>
      <a href={urls.submitBot()} class={buttonVariants({ variant: 'hivis', size: 'sm' })}>
        Submit a bot
      </a>
    </div>
  </div>
</header>
