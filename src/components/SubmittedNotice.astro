---
/**
 * Confirmation after a plain form POST.
 *
 * The form redirects back with ?posted=1 rather than rendering a result page,
 * so there is no resubmit-on-refresh and no JavaScript needed to show the
 * outcome. Errors come back the same way.
 */
const params = Astro.url.searchParams;
const posted = params.get('posted') === '1';
const error = params.get('error');

// `storage` means the write failed, so we have nothing. Saying "try again" is
// not a platitude here — it is the difference between the submitter resending
// and them believing we have something we do not.
const message = posted
  ? null
  : error === 'short'
    ? 'That was too short to act on — give us a sentence.'
    : error === 'rate'
      ? 'That is a few submissions in quick succession. Try again shortly.'
      : error === 'storage'
        ? 'Something broke at our end and that was not saved — please do send it again, because we have not got it. Sorry.'
        : null;
---

{
  posted && (
    <div class="border-ink bg-hi-vis/20 mb-6 rounded-lg border-[1.5px] p-4">
      <p class="font-semibold">Got it — that is on the list.</p>
      <p class="text-muted-foreground mt-1 text-sm/relaxed">
        A person reads every one. If it is a job people want and nothing does it, it goes up as an
        open position, which is how creators find out somebody wants it.
      </p>
    </div>
  )
}

{
  message && (
    <div class="border-border mb-6 rounded-lg border border-dashed p-4">
      <p class="text-sm">{message}</p>
    </div>
  )
}
