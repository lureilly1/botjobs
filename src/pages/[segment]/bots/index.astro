---
import Base from '@/layouts/Base.astro';
import EvidenceBadge from '@/components/EvidenceBadge.astro';
import { PATH_SEGMENT, urls } from '@/config';
import { getBots, jobsForBot } from '@/lib/data';

if (Astro.params.segment !== PATH_SEGMENT) return new Response(null, { status: 404 });

const bots = (await getBots()).filter((b) => b.description);

// Bots we have actually placed come first — they carry a reasoned fit, so they
// are the ones worth reading. The rest stay browsable below.
const placed = bots.filter((b) => jobsForBot(b.slug).length > 0);
const unplaced = bots.filter((b) => jobsForBot(b.slug).length === 0);
const verified = bots.filter((b) => b.evidenceLevel === 'link-verified').length;
---

<Base
  title="Every bot"
  description="Every Grok Bot we have on file, reconciled against the official x.ai listing."
  canonical={urls.bots()}
>
  <section class="mx-auto max-w-6xl px-4 pt-12 pb-8 sm:px-6 sm:pt-16">
    <p class="eyebrow text-muted-foreground">The candidate pool</p>
    <h1 class="mt-3 text-[2.25rem] leading-[1.02] sm:text-5xl">
      Every bot on <span class="marker">file</span>
    </h1>
    <p class="prose-editorial mt-4">
      {bots.length} Grok Bots gathered from the public catalogues and reconciled against the
      official x.ai listing for each one — {verified} currently resolve. {placed.length} have been
      put forward for a job; the rest are on file but not yet placed.
    </p>
  </section>

  <div class="mx-auto max-w-6xl px-4 pb-20 sm:px-6">
    <h2 class="mb-3 text-lg">Placed ({placed.length})</h2>
    <ul class="border-ink bg-card rule-list mb-12 overflow-hidden rounded-lg border-[1.5px]">
      {
        placed.map((bot) => (
          <li>
            <a
              href={urls.bot(bot.slug)}
              class="group hover:bg-hi-vis/15 flex items-center gap-4 p-4 transition-colors sm:px-5"
            >
              <div class="min-w-0 flex-1">
                <h3 class="font-semibold">{bot.name}</h3>
                <p class="text-muted-foreground mt-0.5 line-clamp-1 text-sm">{bot.description}</p>
              </div>
              <span class="text-muted-foreground hidden shrink-0 font-mono text-xs sm:block">
                {jobsForBot(bot.slug).length} job{jobsForBot(bot.slug).length === 1 ? '' : 's'}
              </span>
              <EvidenceBadge level={bot.evidenceLevel} />
            </a>
          </li>
        ))
      }
    </ul>

    <h2 class="mb-1 text-lg">On file ({unplaced.length})</h2>
    <p class="text-muted-foreground mb-3 text-sm">
      Catalogued and link-checked, but not yet a good enough fit for any job on the board.
    </p>
    <ul class="flex flex-wrap gap-2">
      {
        unplaced.map((bot) => (
          <li>
            <a
              href={urls.bot(bot.slug)}
              class="border-border bg-card text-muted-foreground hover:border-ink hover:text-foreground inline-block rounded-full border px-3 py-1.5 text-[13px] transition-colors"
            >
              {bot.name}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
