---
import Base from '@/layouts/Base.astro';
import EvidenceBadge from '@/components/EvidenceBadge.astro';
import JsonLd from '@/components/JsonLd.astro';
import { buttonVariants } from '@/components/ui/button';
import { PATH_SEGMENT, urls } from '@/config';
import { getBots, jobsForBot } from '@/lib/data';
import { INTEGRATIONS, INTEGRATION_MIN_BOTS, INTEGRATION_MIN_PLACED } from '@/lib/records.js';
import { breadcrumbs, collectionNode } from '@/lib/seo';

if (Astro.params.segment !== PATH_SEGMENT) return new Response(null, { status: 404 });

const slug = Astro.params.slug!;
const meta = (INTEGRATIONS as Record<string, { label: string; intro: string }>)[slug];
if (!meta) return new Response(null, { status: 404 });

const matching = (await getBots()).filter((b) => (b.integrations ?? []).includes(slug) && b.description);
const placed = matching.filter((b) => jobsForBot(b.slug).length > 0);

// The same bar the page list uses. A page that has fallen below it since the
// last ingest should stop existing rather than linger as a thin one.
if (matching.length < INTEGRATION_MIN_BOTS || placed.length < INTEGRATION_MIN_PLACED) {
  return new Response(null, { status: 404 });
}

// Jobs these bots are actually put forward for — the useful cross-link, since
// somebody searching "grok bot for gmail" usually wants a job, not a list.
const jobCounts = new Map<string, { title: string; slug: string; n: number }>();
for (const bot of placed) {
  for (const { job } of jobsForBot(bot.slug)) {
    const entry = jobCounts.get(job.slug) ?? { title: job.title, slug: job.slug, n: 0 };
    entry.n += 1;
    jobCounts.set(job.slug, entry);
  }
}
const relatedJobs = [...jobCounts.values()].sort((a, b) => b.n - a.n).slice(0, 6);
const ordered = [...placed, ...matching.filter((b) => !placed.includes(b))];
---

<Base
  title={`Grok Bots for ${meta.label} — ${matching.length} that connect to it`}
  description={`${matching.length} Grok Bots that work with ${meta.label}, each checked against its official x.ai listing. What they do, what they assume, and which jobs they are put forward for.`}
  canonical={urls.integration(slug)}
>
  <JsonLd
    data={[
      collectionNode({
        name: `Grok Bots for ${meta.label}`,
        path: urls.integration(slug),
        description: `Grok Bots that connect to ${meta.label}.`,
        items: ordered.map((b) => ({ name: b.name, path: urls.bot(b.slug) })),
      }),
      breadcrumbs([
        { name: 'Bots', path: urls.bots() },
        { name: meta.label, path: urls.integration(slug) },
      ]),
    ]}
  />

  <section class="mx-auto max-w-4xl px-4 pt-12 pb-8 sm:px-6 sm:pt-16">
    <nav class="text-muted-foreground mb-6 text-sm" aria-label="Breadcrumb">
      <a href={urls.bots()} class="hover:text-foreground">Bots</a>
      <span class="mx-1.5" aria-hidden="true">/</span>
      <span class="text-foreground">{meta.label}</span>
    </nav>

    <p class="eyebrow text-muted-foreground">Integration</p>
    <h1 class="mt-3 text-[2.25rem] leading-[1.02] sm:text-5xl">
      Grok Bots for <span class="marker">{meta.label}</span>
    </h1>
    <p class="prose-editorial mt-5">{meta.intro}</p>
    <p class="text-muted-foreground mt-4 font-mono text-sm">
      {matching.length} on file · {placed.length} put forward for a job
    </p>

    {
      relatedJobs.length > 0 && (
        <div class="mt-8">
          <p class="eyebrow text-muted-foreground">What people use it for</p>
          <ul class="mt-2.5 flex flex-wrap gap-2">
            {relatedJobs.map((j) => (
              <li>
                <a
                  href={urls.job(j.slug)}
                  class="border-border bg-card hover:border-ink inline-block rounded-full border px-3 py-1.5 text-[13px] font-medium transition-colors"
                >
                  {j.title}
                  <span class="text-muted-foreground font-mono text-xs"> {j.n}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>

  <div class="mx-auto max-w-4xl px-4 pb-20 sm:px-6">
    <ul class="border-ink bg-card rule-list overflow-hidden rounded-lg border-[1.5px]">
      {
        ordered.map((bot) => (
          <li>
            <a
              href={urls.bot(bot.slug)}
              class="group hover:bg-hi-vis/15 flex items-center gap-4 p-4 transition-colors sm:px-5"
            >
              <div class="min-w-0 flex-1">
                <h2 class="font-semibold">{bot.name}</h2>
                <p class="text-muted-foreground mt-0.5 line-clamp-1 text-sm">{bot.description}</p>
              </div>
              <EvidenceBadge level={bot.evidenceLevel} />
            </a>
          </li>
        ))
      }
    </ul>

    <p class="text-muted-foreground mt-6 text-xs leading-relaxed">
      Membership is worked out from what each bot's official listing says it connects to, not from
      a keyword match — “reads your email” is not {meta.label} unless it plainly is. Read the{' '}
      <a href="/methodology" class="underline underline-offset-2">methodology</a> for how that is
      decided and what our evidence labels claim.
    </p>

    <a
      href={urls.submitBot()}
      class={buttonVariants({ variant: 'secondary', size: 'sm', className: 'mt-6' })}
    >
      Know one we're missing?
    </a>
  </div>
</Base>
