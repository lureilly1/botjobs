---
import Base from '@/layouts/Base.astro';
import BotCard from '@/components/BotCard.astro';
import { Badge } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import { FRAMEWORK, urls, REPO } from '@/config';
import { getJob, getJobs, botsForJob, categoryLabel } from '@/lib/data';
import JsonLd from '@/components/JsonLd.astro';
import PostJobDialog from '@/components/PostJobDialog.astro';
import SubmittedNotice from '@/components/SubmittedNotice.astro';
import { breadcrumbs, jobPageNode, jobFaqNode } from '@/lib/seo';


const job = await getJob(Astro.params.slug!);
if (!job) return new Response(null, { status: 404 });

const bots = botsForJob(job);
const allJobs = await getJobs();
const related = job.relatedJobs
  .map((slug) => allJobs.find((j) => j.slug === slug))
  .filter((j): j is NonNullable<typeof j> => Boolean(j));

// The spec wanted 3-8 related jobs per page and the hand-written relatedJobs
// average 2-3. Topping up with siblings from the same category gets the
// topical cluster the internal-link graph is supposed to form, and gives
// category pages the inbound links they were missing.
const siblings = allJobs
  .filter((j) => j.category === job.category && j.slug !== job.slug)
  .filter((j) => !job.relatedJobs.includes(j.slug))
  .sort((a, b) => b.bots.length - a.bots.length)
  .slice(0, Math.max(0, 6 - job.relatedJobs.length));

const isOpen = job.status === 'open';
const label = categoryLabel(job.category);

/*
 * TITLED AS A ROLE, NOT AS A FRAMEWORK.
 *
 * The job is the primary object and the framework is a section within it, so
 * the H1 and the title tag carry the role noun and nothing else. "Best AI chief
 * of staff bots" — not "Best Grok Bots for …", which was competing for a term
 * the vendor owns and which no measurement on this domain can currently see.
 *
 * The framework does still appear on the page: the candidates section below is
 * headed as Grok Bot candidates, which is exactly where a second framework
 * would slot in later without any of this needing to change.
 */
const title = isOpen ? `${job.title}: no bot does this yet` : `Best ${job.title} bots`;
const description = isOpen
  ? `Nobody has built a bot for ${job.title.toLowerCase()} worth recommending yet. Here is what the job involves and what one would need to do.`
  : `${bots.length} ${bots.length === 1 ? 'candidate' : 'candidates'} for ${job.title.toLowerCase()}, ranked, with the sources and evidence behind each.`;
---

<Base
  title={title}
  description={description}
  canonical={urls.job(job.slug)}
  ogImage={`/og/job-${job.slug}.png`}
>
  <JsonLd
    data={[
      jobPageNode(job, bots.length),
      jobFaqNode(job, bots.length),
      breadcrumbs([
        { name: 'Jobs', path: urls.jobs() },
        { name: label },
        { name: job.title, path: urls.job(job.slug) },
      ]),
    ]}
  />
  <article class="mx-auto max-w-3xl px-4 pt-10 pb-16 sm:px-6 sm:pt-14">
    {/* Posting a job from this page redirects back to it, so the confirmation
        has to live here too — otherwise the submission looks like it vanished. */}
    <SubmittedNotice />

    <nav class="text-muted-foreground mb-6 text-sm" aria-label="Breadcrumb">
      <a href={urls.jobs()} class="hover:text-foreground">Jobs</a>
      <span class="mx-1.5" aria-hidden="true">/</span>
      <span class="text-foreground">{label}</span>
    </nav>

    <div class="flex flex-wrap items-center gap-2.5">
      <p class="eyebrow text-muted-foreground">{label}</p>
      {isOpen && <Badge variant="open">Open position</Badge>}
    </div>

    <h1 class="mt-3 text-[2rem] leading-[1.05] sm:text-[2.6rem]">
      {isOpen ? job.title : <>Best <span class="marker">{job.title}</span> bots</>}
    </h1>

    <p class="text-muted-foreground mt-3 font-mono text-sm">{job.searchIntent}</p>

    {/* The task phrasing, kept as a heading on a page now titled as a role. A
        rename should cover both forms — people who search the workflow and
        people who search the job a human holds are looking for one page. */}
    {
      job.taskTitle && (
        <h2 class="mt-8 text-xl">What the {job.taskTitle.toLowerCase()} job involves</h2>
      )
    }

    <div class="prose-editorial mt-6 max-w-none space-y-4">
      {job.intro.split('\n\n').map((para) => <p>{para}</p>)}
    </div>

    {
      !job.introCurated && (
        /* Honesty about provenance is what separates this from the scaled-content
           pattern. If a draft has not been through a human, the page says so. */
        <p class="border-border text-muted-foreground mt-5 rounded-md border border-dashed px-3.5 py-2.5 text-xs">
          This introduction was drafted automatically and has not been edited by a person yet.{' '}
          <a href={`${REPO}/edit/main/data/jobs/${job.slug}.json`} rel="noopener" class="underline underline-offset-2">
            Improve it →
          </a>
        </p>
      )
    }

    {/* THE FRAMEWORK SECTION. The page is about the job; this is the part of it
        that is about a particular product. A second framework lands as a
        sibling section here, not as a second site. */}
    {
      bots.length > 0 && (
        <section class="mt-12">
          <h2 class="text-2xl">
            {bots.length} {FRAMEWORK} {bots.length === 1 ? 'candidate' : 'candidates'}
          </h2>
          <p class="text-muted-foreground mt-1 mb-6 text-sm">
            Ranked by how well they fit this job, not by popularity.
          </p>
          <div class="space-y-4">
            {bots.map((bot) => (
              <BotCard bot={bot} jobSlug={job.slug} />
            ))}
          </div>
        </section>
      )
    }

    {
      isOpen && (
        <section class="outlined bg-card mt-12 rounded-lg p-6 sm:p-7">
          <h2 class="text-2xl">Nobody has applied yet</h2>
          <p class="prose-editorial mt-2.5">
            We have not found a {FRAMEWORK} that does this job well enough to recommend. Rather than
            fill the slot with something that does not do the work, the position stays open — so
            if you were looking for something to build, this is a job people want done.
          </p>
          <div class="mt-5 flex flex-wrap gap-2.5">
            <a
              href={`${urls.submitBot()}&job=${encodeURIComponent(job.slug)}`}
              class={buttonVariants({ variant: 'hivis', size: 'sm' })}
            >
              I know a bot that does this
            </a>
            <a href={urls.openJobs()} class={buttonVariants({ variant: 'secondary', size: 'sm' })}>
              Other open jobs
            </a>
          </div>
        </section>
      )
    }

    {
      !isOpen && (
        <section class="border-border mt-12 rounded-lg border border-dashed p-5">
          <h2 class="text-lg">Know a better bot for this?</h2>
          <p class="prose-editorial mt-1.5 text-sm">
            Candidates are put forward by people who have actually used them. If something is
            missing, or a listing here is wrong, tell us and we will fix it.
          </p>
          <div class="mt-4 flex flex-wrap gap-2.5">
            <a
              href={`${urls.submitBot()}&job=${encodeURIComponent(job.slug)}`}
              class={buttonVariants({ variant: 'secondary', size: 'sm' })}
            >
              Put a bot forward
            </a>
            <PostJobDialog
              label="Post a different job"
              variant="ghost"
              fromJob={job.slug}
            />
          </div>
        </section>
      )
    }

    {
      job.integrations.length > 0 && (
        <section class="mt-10">
          <h2 class="eyebrow text-muted-foreground">Usually needs</h2>
          {/* Plain chips, not links: integration pages do not exist yet, and a
              link to nothing is worse than no link. */}
          <ul class="mt-2.5 flex flex-wrap gap-2">
            {job.integrations.map((i) => (
              <li class="border-border bg-secondary rounded-full border px-2.5 py-1 font-mono text-xs">
                {i}
              </li>
            ))}
          </ul>
        </section>
      )
    }

    {
      related.length > 0 && (
        <section class="mt-10">
          <h2 class="eyebrow text-muted-foreground">Related jobs</h2>
          <p class="sr-only">Other jobs in {label}</p>
          <ul class="mt-2.5 flex flex-wrap gap-2">
            {[...related, ...siblings].map((r) => (
              <li>
                <a
                  href={urls.job(r.slug)}
                  class="border-border bg-card hover:border-ink inline-block rounded-full border px-3 py-1.5 text-[13px] font-medium transition-colors"
                >
                  {r.title}
                  {r.status === 'open' && <span class="text-open-job"> · open</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="mt-10">
      <h2 class="eyebrow text-muted-foreground">Browse</h2>
      <ul class="mt-2.5 flex flex-wrap gap-2">
        <li>
          <a
            href={urls.category(job.category)}
            class="border-ink bg-hi-vis/25 hover:bg-hi-vis inline-block rounded-full border px-3 py-1.5 text-[13px] font-medium transition-colors"
          >
            All {label} jobs
          </a>
        </li>
      </ul>
    </section>

    <section class="border-border text-muted-foreground mt-12 border-t pt-6 text-xs leading-relaxed">
      <p>
        Bots on this page are gathered from public catalogues and reconciled against the official
        x.ai listing for each one. We write our own summaries and never republish a source
        directory's description. Every listing credits where we found it and links to the creator.
      </p>
      <p class="mt-2">
        <a href={urls.submitJob()} class="underline underline-offset-2">Post a job</a>
        <span class="mx-1.5" aria-hidden="true">·</span>
        <a href={urls.submitBot()} class="underline underline-offset-2">Submit a bot</a>
      </p>
    </section>
  </article>
</Base>
